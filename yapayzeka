    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
    transition: 0.5s;
}

.btn-calculate:hover::before {
    left: 100%;
}

.btn-calculate:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(99, 102, 241, 0.4);
}

.btn-calculate:active {
    transform: translateY(0);
}

.btn-reset {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 16px 24px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-glass);
    border-radius: var(--radius-md);
    color: var(--text-secondary);
    font-family: 'Inter', sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    transition: var(--transition);
}

.btn-reset:hover {
    background: rgba(244, 63, 94, 0.1);
    border-color: rgba(244, 63, 94, 0.3);
    color: #f43f5e;
}

.btn-icon {
    font-size: 1.2rem;
}

/* ---- Result Panel ---- */
.result-panel {
    position: relative;
    background: var(--bg-card);
    backdrop-filter: blur(30px);
    border: 1px solid var(--border-glass);
    border-radius: var(--radius-xl);
    padding: 32px;
    overflow: hidden;
    animation: resultReveal 0.6s ease-out;
}

.result-panel.hidden {
    display: none;
}

.result-glow {
    position: absolute;
    top: -100px;
    left: 50%;
    transform: translateX(-50%);
    width: 400px;
    height: 200px;
    background: radial-gradient(circle, rgba(99, 102, 241, 0.3) 0%, transparent 70%);
    pointer-events: none;
}

.result-header {
    text-align: center;
    margin-bottom: 24px;
    position: relative;
}

.result-header h3 {
    font-size: 1.2rem;
    font-weight: 700;
}

.result-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 12px;
    margin-bottom: 24px;
}

.result-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 20px 12px;
    background: rgba(0, 0, 0, 0.2);
    border: 1px solid var(--border-glass);
    border-radius: var(--radius-md);
    text-align: center;
    transition: var(--transition);
}

.result-card:hover {
    background: rgba(0, 0, 0, 0.3);
    transform: translateY(-2px);
}

.result-card.main-score {
    grid-column: 1 / -1;
    padding: 28px 20px;
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.15), rgba(168, 85, 247, 0.15));
    border-color: rgba(99, 102, 241, 0.3);
}

.result-label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.result-value {
    font-family: 'JetBrains Mono', monospace;
    font-size: 2.8rem;
    font-weight: 800;
    background: var(--gradient-1);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    line-height: 1.1;
}

.result-value.small {
    font-size: 1.6rem;
    background: var(--gradient-3);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.result-range {
    font-size: 0.75rem;
    color: var(--text-muted);
}

/* ---- Net Breakdown ---- */
.net-breakdown {
    margin-top: 24px;
    padding-top: 24px;
    border-top: 1px solid var(--border-glass);
}

.net-breakdown h4 {
    font-size: 0.95rem;
    font-weight: 600;
    margin-bottom: 16px;
    text-align: center;
}

.breakdown-bars {
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.breakdown-item {
    display: grid;
    grid-template-columns: 140px 1fr 60px;
    align-items: center;
    gap: 12px;
}

.breakdown-item .subject-name {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-secondary);
    text-align: right;
}

.breakdown-item .bar-track {
    height: 10px;
    background: rgba(0, 0, 0, 0.3);
    border-radius: 100px;
    overflow: hidden;
}

.breakdown-item .bar-fill {
    height: 100%;
    border-radius: 100px;
    transition: width 0.8s cubic-bezier(0.4, 0, 0.2, 1);
    min-width: 0;
}

.breakdown-item .bar-value {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-primary);
    text-align: right;
}

/* ---- AYT Note ---- */
.ayt-note {
    padding: 12px 16px;
    background: rgba(245, 158, 11, 0.1);
    border: 1px solid rgba(245, 158, 11, 0.25);
    border-radius: var(--radius-sm);
    margin-bottom: 16px;
}

.ayt-note p {
    font-size: 0.8rem;
    color: #fbbf24;
    text-align: center;
}

/* ---- Ranking & Percentile Section ---- */
.ranking-section {
    margin-top: 28px;
    padding-top: 28px;
    border-top: 1px solid var(--border-glass);
    animation: fadeInUp 0.5s ease-out;
}

.ranking-section h4 {
    font-size: 1rem;
    font-weight: 700;
    text-align: center;
    margin-bottom: 24px;
    background: var(--gradient-2);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.ranking-hero {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 40px;
    margin-bottom: 32px;
    flex-wrap: wrap;
}

/* Circular Gauge */
.percentile-gauge {
    position: relative;
    width: 160px;
    height: 160px;
    flex-shrink: 0;
}

.gauge-svg {
    width: 100%;
    height: 100%;
    transform: rotate(-90deg);
}

.gauge-track {
    fill: none;
    stroke: rgba(255, 255, 255, 0.06);
    stroke-width: 8;
}

.gauge-fill {
    fill: none;
    stroke: url(#gaugeGradient);
    stroke-width: 8;
    stroke-linecap: round;
    stroke-dasharray: 0 327;
    transition: stroke-dasharray 1.2s cubic-bezier(0.4, 0, 0.2, 1);
}

/* Fallback stroke color when gradient isn't available */
.gauge-fill {
    stroke: #6366f1;
}

.gauge-center {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
}

.gauge-percent {
    font-family: 'JetBrains Mono', monospace;
    font-size: 1.6rem;
    font-weight: 800;
    background: var(--gradient-1);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
}

.gauge-sub {
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 1px;
}

/* Ranking Info */
.ranking-info {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 200px;
}

.ranking-number {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.rank-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.rank-value {
    font-family: 'JetBrains Mono', monospace;
    font-size: 1.8rem;
    font-weight: 800;
    color: var(--text-primary);
    letter-spacing: -0.5px;
}

.ranking-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border-radius: 100px;
    font-size: 0.8rem;
    font-weight: 700;
    width: fit-content;
    transition: var(--transition);
}

.ranking-badge.badge-excellent {
    background: rgba(16, 185, 129, 0.15);
    border: 1px solid rgba(16, 185, 129, 0.3);
    color: #34d399;
}

.ranking-badge.badge-great {
    background: rgba(59, 130, 246, 0.15);
    border: 1px solid rgba(59, 130, 246, 0.3);
    color: #60a5fa;
}

.ranking-badge.badge-good {
    background: rgba(99, 102, 241, 0.15);
    border: 1px solid rgba(99, 102, 241, 0.3);
    color: #a5b4fc;
}

.ranking-badge.badge-average {
    background: rgba(245, 158, 11, 0.15);
    border: 1px solid rgba(245, 158, 11, 0.3);
    color: #fbbf24;
}

.ranking-badge.badge-below {
    background: rgba(244, 63, 94, 0.15);
    border: 1px solid rgba(244, 63, 94, 0.3);
    color: #fb7185;
}

.ranking-detail {
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.detail-label {
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--text-muted);
}

.detail-value {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-secondary);
}

/* Yearly Comparison Table */
.yearly-comparison {
    margin-top: 24px;
}

.yearly-comparison h5 {
    font-size: 0.9rem;
    font-weight: 600;
    text-align: center;
    margin-bottom: 16px;
    color: var(--text-secondary);
}

.yearly-table-wrap {
    overflow-x: auto;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-glass);
}

.yearly-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
}

.yearly-table thead {
    background: rgba(99, 102, 241, 0.1);
}

.yearly-table th {
    padding: 12px 16px;
    font-weight: 700;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: #a5b4fc;
    text-align: center;
    border-bottom: 1px solid var(--border-glass);
}

.yearly-table td {
    padding: 11px 16px;
    text-align: center;
    color: var(--text-secondary);
    border-bottom: 1px solid rgba(255, 255, 255, 0.03);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.82rem;
    font-weight: 500;
}

.yearly-table tbody tr {
    transition: var(--transition);
}

.yearly-table tbody tr:hover {
    background: rgba(99, 102, 241, 0.08);
}

.yearly-table tbody tr:last-child td {
    border-bottom: none;
}

.yearly-table .year-cell {
    font-weight: 700;
    color: var(--text-primary);
}

.yearly-table .highlight-row {
    background: rgba(99, 102, 241, 0.06);
}

.yearly-table .highlight-row td {
    color: var(--text-primary);
    font-weight: 600;
}

.yearly-table .percentile-cell {
    font-weight: 700;
}

.yearly-table .percentile-high {
    color: #34d399;
}

.yearly-table .percentile-mid {
    color: #60a5fa;
}

.yearly-table .percentile-low {
    color: #fbbf24;
}

.yearly-table .percentile-vlow {
    color: #fb7185;
}

/* Gauge animation */
@keyframes gaugeReveal {
    from {
        stroke-dasharray: 0 327;
    }
}

/* ---- Footer ---- */
.app-footer {
    text-align: center;
    margin-top: 48px;
    padding: 24px 20px;
    border-top: 1px solid var(--border-glass);
}

.app-footer p {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-bottom: 4px;
}

.footer-credit {
    font-size: 0.75rem;
    color: var(--text-muted);
    opacity: 0.7;
}

/* ---- Animations ---- */
@keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}

@keyframes fadeInDown {
    from {
        opacity: 0;
        transform: translateY(-20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

@keyframes resultReveal {
    from {
        opacity: 0;
        transform: translateY(30px) scale(0.95);
    }
    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

@keyframes scoreCount {
    from { transform: scale(0.8); opacity: 0; }
    50% { transform: scale(1.05); }
    to { transform: scale(1); opacity: 1; }
}

.score-animate {
    animation: scoreCount 0.5s ease-out;
}

/* ---- Scrollbar ---- */
::-webkit-scrollbar {
    width: 8px;
}

::-webkit-scrollbar-track {
    background: transparent;
}

::-webkit-scrollbar-thumb {
    background: rgba(99, 102, 241, 0.3);
    border-radius: 100px;
}

::-webkit-scrollbar-thumb:hover {
    background: rgba(99, 102, 241, 0.5);
}

/* ---- Responsive ---- */
@media (max-width: 768px) {
    .app-container {
        padding: 16px 12px 40px;
    }

    .title-gradient {
        font-size: 2.2rem;
    }

    .title-sub {
        font-size: 1.1rem;
    }

    .subjects-grid {
        grid-template-columns: 1fr;
    }

    .input-row {
        flex-wrap: wrap;
    }

    .input-group {
        min-width: calc(50% - 6px);
    }

    .net-display {
        width: 100%;
        flex-direction: row;
        justify-content: center;
        gap: 8px;
    }

    .result-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .result-value {
        font-size: 2rem;
    }

    .result-value.small {
        font-size: 1.3rem;
    }

    .action-buttons {
        flex-direction: column;
    }

    .breakdown-item {
        grid-template-columns: 100px 1fr 50px;
    }

    .breakdown-item .subject-name {
        font-size: 0.75rem;
    }

    .ayt-type-buttons {
        flex-wrap: wrap;
    }

    .ayt-type-btn {
        min-width: calc(50% - 4px);
    }

    .result-panel {
        padding: 20px 16px;
    }

    .ranking-hero {
        flex-direction: column;
        gap: 24px;
        text-align: center;
    }

    .ranking-info {
        align-items: center;
        min-width: unset;
    }

    .ranking-number {
        align-items: center;
    }

    .percentile-gauge {
        width: 140px;
        height: 140px;
    }

    .yearly-table th,
    .yearly-table td {
        padding: 8px 10px;
        font-size: 0.75rem;
    }
}

@media (max-width: 480px) {
    .title-gradient {
        font-size: 1.8rem;
    }

    .tab-label {
        font-size: 0.95rem;
    }

    .result-grid {
        grid-template-columns: 1fr 1fr;
    }

    .breakdown-item {
        grid-template-columns: 80px 1fr 45px;
    }

    .rank-value {
        font-size: 1.4rem;
    }

    .gauge-percent {
        font-size: 1.3rem;
    }
}

