                                    <label for="ayt-soz-fel-yanlis">Yanlış</label>
                                    <div class="input-wrapper wrong">
                                        <button class="input-btn minus" onclick="adjustValue('ayt-soz-fel-yanlis', -1, 12)">−</button>
                                        <input type="number" id="ayt-soz-fel-yanlis" min="0" max="12" value="0" oninput="validateInput(this, 12)">
                                        <button class="input-btn plus" onclick="adjustValue('ayt-soz-fel-yanlis', 1, 12)">+</button>
                                    </div>
                                </div>
                                <div class="net-display">
                                    <span class="net-label">Net</span>
                                    <span class="net-value" id="ayt-soz-fel-net">0.00</span>
                                </div>
                            </div>
                        </div>
                        <div class="subject-card" style="--accent: #ec4899; --accent-light: rgba(236,72,153,0.15);">
                            <div class="subject-header">
                                <div class="subject-icon-wrap"><span class="subject-icon">⚖️</span></div>
                                <div class="subject-info"><h3>Din Kültürü</h3><span class="question-count">6 Soru</span></div>
                            </div>
                            <div class="input-row">
                                <div class="input-group">
                                    <label for="ayt-soz-din-dogru">Doğru</label>
                                    <div class="input-wrapper correct">
                                        <button class="input-btn minus" onclick="adjustValue('ayt-soz-din-dogru', -1, 6)">−</button>
                                        <input type="number" id="ayt-soz-din-dogru" min="0" max="6" value="0" oninput="validateInput(this, 6)">
                                        <button class="input-btn plus" onclick="adjustValue('ayt-soz-din-dogru', 1, 6)">+</button>
                                    </div>
                                </div>
                                <div class="input-group">
                                    <label for="ayt-soz-din-yanlis">Yanlış</label>
                                    <div class="input-wrapper wrong">
                                        <button class="input-btn minus" onclick="adjustValue('ayt-soz-din-yanlis', -1, 6)">−</button>
                                        <input type="number" id="ayt-soz-din-yanlis" min="0" max="6" value="0" oninput="validateInput(this, 6)">
                                        <button class="input-btn plus" onclick="adjustValue('ayt-soz-din-yanlis', 1, 6)">+</button>
                                    </div>
                                </div>
                                <div class="net-display">
                                    <span class="net-label">Net</span>
                                    <span class="net-value" id="ayt-soz-din-net">0.00</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- DİL Fields -->
                <div class="ayt-fields" id="ayt-fields-dil">
                    <div class="subjects-grid">
                        <div class="subject-card full-width" style="--accent: #06b6d4; --accent-light: rgba(6,182,212,0.15);">
                            <div class="subject-header">
                                <div class="subject-icon-wrap"><span class="subject-icon">🌐</span></div>
                                <div class="subject-info"><h3>Yabancı Dil</h3><span class="question-count">80 Soru</span></div>
                            </div>
                            <div class="input-row">
                                <div class="input-group">
                                    <label for="ayt-dil-dogru">Doğru</label>
                                    <div class="input-wrapper correct">
                                        <button class="input-btn minus" onclick="adjustValue('ayt-dil-dogru', -1, 80)">−</button>
                                        <input type="number" id="ayt-dil-dogru" min="0" max="80" value="0" oninput="validateInput(this, 80)">
                                        <button class="input-btn plus" onclick="adjustValue('ayt-dil-dogru', 1, 80)">+</button>
                                    </div>
                                </div>
                                <div class="input-group">
                                    <label for="ayt-dil-yanlis">Yanlış</label>
                                    <div class="input-wrapper wrong">
                                        <button class="input-btn minus" onclick="adjustValue('ayt-dil-yanlis', -1, 80)">−</button>
                                        <input type="number" id="ayt-dil-yanlis" min="0" max="80" value="0" oninput="validateInput(this, 80)">
                                        <button class="input-btn plus" onclick="adjustValue('ayt-dil-yanlis', 1, 80)">+</button>
                                    </div>
                                </div>
                                <div class="net-display">
                                    <span class="net-label">Net</span>
                                    <span class="net-value" id="ayt-dil-net">0.00</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- AYT Action Buttons -->
                <div class="action-buttons">
                    <button class="btn-calculate" id="btn-ayt-calculate" onclick="calculateAYT()">
                        <span class="btn-icon">⚡</span>
                        <span>AYT Puanını Hesapla</span>
                    </button>
                    <button class="btn-reset" id="btn-ayt-reset" onclick="resetAYT()">
                        <span class="btn-icon">🔄</span>
                        <span>Sıfırla</span>
                    </button>
                </div>

                <!-- AYT Result -->
                <div class="result-panel hidden" id="ayt-result">
                    <div class="result-glow"></div>
                    <div class="result-header">
                        <h3>📊 AYT Sonuçlarınız</h3>
                    </div>
                    <div class="result-grid">
                        <div class="result-card main-score">
                            <span class="result-label" id="ayt-puan-label">Tahmini SAY Puanı</span>
                            <span class="result-value" id="ayt-puan">0.00</span>
                            <span class="result-range">TYT puanınız da hesaplamaya dahildir</span>
                        </div>
                        <div class="result-card">
                            <span class="result-label">AYT Net</span>
                            <span class="result-value small" id="ayt-toplam-net">0.00</span>
                        </div>
                        <div class="result-card">
                            <span class="result-label">Toplam Doğru</span>
                            <span class="result-value small" id="ayt-toplam-dogru">0</span>
                        </div>
                        <div class="result-card">
                            <span class="result-label">Toplam Yanlış</span>
                            <span class="result-value small" id="ayt-toplam-yanlis">0</span>
                        </div>
                    </div>
                    <div class="ayt-note">
                        <p>⚠️ AYT puanı hesaplanırken TYT netleri de kullanılır. Daha doğru sonuç için önce TYT bölümünü doldurun.</p>
                    </div>
                    <div class="net-breakdown" id="ayt-net-breakdown">
                        <h4>📋 Ders Bazlı Net Dağılımı</h4>
                        <div class="breakdown-bars" id="ayt-breakdown-bars"></div>
                    </div>

                    <!-- Ranking & Percentile Section -->
                    <div class="ranking-section" id="ayt-ranking-section">
                        <h4>🏆 Tahmini Sıralama & Yüzdelik Dilim</h4>
                        <div class="ranking-hero">
                            <div class="percentile-gauge">
                                <svg viewBox="0 0 120 120" class="gauge-svg">
                                    <circle cx="60" cy="60" r="52" class="gauge-track"/>
                                    <circle cx="60" cy="60" r="52" class="gauge-fill" id="ayt-gauge-fill" stroke-dasharray="0 327" />
                                </svg>
                                <div class="gauge-center">
                                    <span class="gauge-percent" id="ayt-percentile">%0</span>
                                    <span class="gauge-sub">Yüzdelik</span>
                                </div>
                            </div>
                            <div class="ranking-info">
                                <div class="ranking-number">
                                    <span class="rank-label">Tahmini Sıralama</span>
                                    <span class="rank-value" id="ayt-siralama">—</span>
                                </div>
                                <div class="ranking-badge" id="ayt-badge">—</div>
                                <div class="ranking-detail">
                                    <span class="detail-label" id="ayt-detail-label">Ortalama Aday Sayısı</span>
                                    <span class="detail-value" id="ayt-avg-students">—</span>
                                </div>
                            </div>
                        </div>
                        <div class="yearly-comparison">
                            <h5>📅 Son 5 Yıl Karşılaştırması</h5>
                            <div class="yearly-table-wrap">
                                <table class="yearly-table" id="ayt-yearly-table">
                                    <thead>
                                        <tr>
                                            <th>Yıl</th>
                                            <th>Aday Sayısı</th>
                                            <th>Tahmini Sıralama</th>
                                            <th>Yüzdelik Dilim</th>
                                        </tr>
                                    </thead>
                                    <tbody id="ayt-yearly-tbody">
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Footer -->
        <footer class="app-footer">
            <p>⚠️ Bu hesaplama yaklaşık değerler içerir. Gerçek puanlar ÖSYM/MEB tarafından belirlenir.</p>
            <p class="footer-credit">© 2026 | Öğrenciler için geliştirilmiştir 💜</p>
        </footer>
    </div>

    <script src="app.js"></script>
</body>
</html>
